{% extends '@PrestaShop/Admin/layout.html.twig' %}

{# Оформление полей в стиле админки PrestaShop #}
{% form_theme form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
    {{ form_start(form) }}
        <div class="card">
            <div class="card-header">
                <i class="material-icons">webhook</i>
                {{ title }}
            </div>
            <div class="card-body">
                {{ form_widget(form) }}
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a class="btn btn-outline-secondary" href="{{ path('ps_webhooks_index') }}">
                    {{ 'Cancel'|trans({}, 'Modules.Pswebhooks.Admin') }}
                </a>
                <button type="submit" class="btn btn-primary">
                    {{ 'Save'|trans({}, 'Modules.Pswebhooks.Admin') }}
                </button>
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}