{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    {# Подписи действий: в базе хранится add/update/delete, человеку показываем слова #}
    {% set actionLabels = {
        'add': 'Created'|trans({}, 'Modules.Pswebhooks.Admin'),
        'update': 'Updated'|trans({}, 'Modules.Pswebhooks.Admin'),
        'delete': 'Deleted'|trans({}, 'Modules.Pswebhooks.Admin')
    } %}

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="material-icons">webhook</i>
                {{ 'Webhooks'|trans({}, 'Modules.Pswebhooks.Admin') }} ({{ webhooks|length }})
            </span>
            <span>
                {% if webhooks|length > 0 %}
                    <a class="btn btn-outline-secondary" href="{{ path('ps_webhooks_export') }}">
                        <i class="material-icons">download</i>
                        {{ 'Export JSON'|trans({}, 'Modules.Pswebhooks.Admin') }}
                    </a>
                    <form method="post" class="d-inline"
                          action="{{ path('ps_webhooks_delete_all') }}"
                          onsubmit="return confirm('{{ 'Delete all webhooks?'|trans({}, 'Modules.Pswebhooks.Admin')|e('js') }}');">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('ps_webhooks_delete_all') }}">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="material-icons">delete</i>
                            {{ 'Delete all'|trans({}, 'Modules.Pswebhooks.Admin') }}
                        </button>
                    </form>
                {% endif %}
                <a class="btn btn-primary" href="{{ path('ps_webhooks_create') }}">
                    <i class="material-icons">add_circle_outline</i>
                    {{ 'Add new'|trans({}, 'Modules.Pswebhooks.Admin') }}
                </a>
            </span>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>{{ 'Action'|trans({}, 'Modules.Pswebhooks.Admin') }}</th>
                        <th>{{ 'Entity'|trans({}, 'Modules.Pswebhooks.Admin') }}</th>
                        <th>{{ 'URL'|trans({}, 'Modules.Pswebhooks.Admin') }}</th>
                        <th>{{ 'Description'|trans({}, 'Modules.Pswebhooks.Admin') }}</th>
                        <th>{{ 'Enabled'|trans({}, 'Modules.Pswebhooks.Admin') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for webhook in webhooks %}
                        <tr>
                            <td>{{ webhook.id }}</td>
                            <td>{{ actionLabels[webhook.action]|default(webhook.action) }}</td>
                            <td>{{ webhook.entity }}</td>
                            <td>{{ webhook.url }}</td>
                            <td>{{ webhook.description|default('—') }}</td>
                            <td>
                                {% if webhook.active %}
                                    <i class="material-icons text-success">check</i>
                                {% else %}
                                    <i class="material-icons text-danger">close</i>
                                {% endif %}
                            </td>
                            <td class="text-right text-nowrap">
                                <form method="post" class="d-inline"
                                      action="{{ path('ps_webhooks_test', {id: webhook.id}) }}">
                                    <input type="hidden" name="_csrf_token"
                                           value="{{ csrf_token('ps_webhooks_test_' ~ webhook.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {{ 'Test'|trans({}, 'Modules.Pswebhooks.Admin') }}
                                    </button>
                                </form>

                                <a class="btn btn-sm btn-outline-secondary"
                                   href="{{ path('ps_webhooks_edit', {id: webhook.id}) }}">
                                    {{ 'Edit'|trans({}, 'Modules.Pswebhooks.Admin') }}
                                </a>

                                <form method="post" class="d-inline"
                                      action="{{ path('ps_webhooks_toggle', {id: webhook.id}) }}">
                                    <input type="hidden" name="_csrf_token"
                                           value="{{ csrf_token('ps_webhooks_toggle_' ~ webhook.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {{ (webhook.active ? 'Disable' : 'Enable')|trans({}, 'Modules.Pswebhooks.Admin') }}
                                    </button>
                                </form>

                                <form method="post" class="d-inline"
                                      action="{{ path('ps_webhooks_delete', {id: webhook.id}) }}"
                                      onsubmit="return confirm('{{ 'Delete this webhook?'|trans({}, 'Modules.Pswebhooks.Admin')|e('js') }}');">
                                    <input type="hidden" name="_csrf_token"
                                           value="{{ csrf_token('ps_webhooks_delete_' ~ webhook.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        {{ 'Delete'|trans({}, 'Modules.Pswebhooks.Admin') }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">{{ 'No webhooks configured yet.'|trans({}, 'Modules.Pswebhooks.Admin') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="material-icons">upload</i>
            {{ 'Import Webhooks'|trans({}, 'Modules.Pswebhooks.Admin') }}
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" action="{{ path('ps_webhooks_import') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('ps_webhooks_import') }}">
                <div class="form-group">
                    <label for="import_json">{{ 'JSON file'|trans({}, 'Modules.Pswebhooks.Admin') }}</label>
                    <input type="file" class="form-control-file" id="import_json" name="import_json"
                           accept=".json,application/json" required>
                </div>
                <button type="submit" class="btn btn-primary">
                    {{ 'Upload and Import'|trans({}, 'Modules.Pswebhooks.Admin') }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}